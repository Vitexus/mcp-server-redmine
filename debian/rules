#!/usr/bin/make -f

export PYBUILD_NAME=redmine-mcp-server

# All Python dependencies (including pydantic / pydantic-core) come from
# Debian packages. Nothing is downloaded from PyPI or bundled at build time.
# The pybuild-generated entry points (mcp-server-redmine, redmine-mcp-server)
# are installed as-is.

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	# Two binary packages: install the Python code into the main one
	dh_auto_install --destdir=debian/mcp-server-redmine

override_dh_auto_test:
	# Skip tests - test dependencies not packaged
