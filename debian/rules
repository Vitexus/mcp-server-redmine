#!/usr/bin/make -f

export PYBUILD_NAME=redmine-mcp-server
# Versions to bundle privately under /usr/lib/redmine-mcp-server/
# pydantic-core 2.46.x needs typing-extensions >= 4.14.1 (Sentinel);
# Debian trixie ships 4.13.2, which lacks it.
PYDANTIC_CORE_VER   := 2.46.3
TYPING_EXT_VER      := 4.14.1
BUNDLE_DIR          := debian/redmine-mcp-server/usr/lib/redmine-mcp-server

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	# Skip tests - test dependencies not packaged

override_dh_auto_install:
	dh_auto_install
	# -- Bundle private pydantic-core (system 2.27.2 is incompatible) --
	install -d $(BUNDLE_DIR)
	pip3 download --no-deps "pydantic-core==$(PYDANTIC_CORE_VER)" \
		-d /tmp/rms-pydantic-core
	python3 -m zipfile -e \
		$$(ls /tmp/rms-pydantic-core/pydantic_core-$(PYDANTIC_CORE_VER)-*.whl | head -1) \
		/tmp/rms-pydantic-core-src/
	cp -r /tmp/rms-pydantic-core-src/pydantic_core $(BUNDLE_DIR)/
	# -- Bundle private typing-extensions (system 4.13.2 lacks Sentinel) --
	pip3 download --no-deps "typing-extensions==$(TYPING_EXT_VER)" \
		-d /tmp/rms-typing-ext
	python3 -m zipfile -e \
		$$(ls /tmp/rms-typing-ext/typing_extensions-$(TYPING_EXT_VER)-*.whl | head -1) \
		/tmp/rms-typing-ext-src/
	cp /tmp/rms-typing-ext-src/typing_extensions.py $(BUNDLE_DIR)/
	# -- Replace pybuild launcher with PYTHONPATH wrapper --
	install -m 755 debian/redmine-mcp-server.launcher \
		debian/redmine-mcp-server/usr/bin/redmine-mcp-server

override_dh_auto_clean:
	dh_auto_clean
	rm -rf /tmp/rms-pydantic-core /tmp/rms-pydantic-core-src \
	       /tmp/rms-typing-ext /tmp/rms-typing-ext-src || true
